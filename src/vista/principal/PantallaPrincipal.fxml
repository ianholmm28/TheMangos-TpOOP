<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.principal.PantallaPrincipalController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="24.0">
         <children>
            <HBox spacing="24.0">
               <children>
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="saldo-label" text="Saldo disponible" />
                        <Label fx:id="lblSaldo" styleClass="saldo-monto" text="\$ 0,00" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#recargarSaldo" styleClass="boton-primario" text="Recargar saldo" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
                     </padding>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" minWidth="320.0" spacing="12.0" styleClass="card">
                     <children>
                        <Label styleClass="seccion-titulo" text="Acciones" />
                        <Label styleClass="subtitulo" text="Sumá un vehículo nuevo al sistema" wrapText="true" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarVehiculo" styleClass="boton-primario" text="Registrar nuevo vehículo" />
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="seccion-titulo" text="Últimos viajes" />
                        <TableView fx:id="tablaViajes" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colViajeFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colViajeVehiculo" prefWidth="140.0" text="Vehículo" />
                              <TableColumn fx:id="colViajeMinutos" prefWidth="90.0" text="Minutos" />
                              <TableColumn fx:id="colViajeImporte" prefWidth="100.0" text="Importe" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no hiciste ningún viaje" />
                           </placeholder>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
                  <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="seccion-titulo" text="Movimientos" />
                        <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colMovFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colMovConcepto" prefWidth="180.0" text="Concepto" />
                              <TableColumn fx:id="colMovTipo" prefWidth="90.0" text="Tipo" />
                              <TableColumn fx:id="colMovImporte" prefWidth="100.0" text="Importe" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no hay movimientos" />
                           </placeholder>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
