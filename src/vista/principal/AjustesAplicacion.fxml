<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.principal.AjustesAplicacionController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Hyperlink onAction="#volver" styleClass="link" text="← Volver al inicio" />
            <HBox alignment="TOP_CENTER" fillHeight="false" spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox maxWidth="520.0" prefWidth="520.0" spacing="18.0" styleClass="card">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="titulo" text="Datos personales" />
                              <Label fx:id="lblDatos" styleClass="subtitulo" text="Documento - email" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="campo-label" text="Nombre" />
                              <TextField fx:id="txtNombre" promptText="Tu nombre completo" />
                           </children>
                        </VBox>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarNombre" styleClass="boton-primario" text="Guardar nombre" />
                        <Label fx:id="lblMensajeNombre" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                     </padding>
                  </VBox>
                  <VBox maxWidth="520.0" prefWidth="520.0" spacing="18.0" styleClass="card">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="titulo" text="Medios de pago" />
                              <Label styleClass="subtitulo" text="Los que uses para recargar saldo" wrapText="true" />
                           </children>
                        </VBox>
                        <ListView fx:id="lstMedios" prefHeight="180.0" />
                        <Button mnemonicParsing="false" onAction="#quitarMedioPago" styleClass="boton-secundario" text="Quitar seleccionado" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="campo-label" text="Agregar un medio de pago" />
                              <HBox spacing="8.0">
                                 <children>
                                    <ComboBox fx:id="cmbTipo" prefWidth="190.0" promptText="Tipo" />
                                    <TextField fx:id="txtIdentificador" promptText="Últimos 4 dígitos o alias" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#agregarMedioPago" styleClass="boton-primario" text="Agregar medio de pago" />
                        <Label fx:id="lblMensajeMedios" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
