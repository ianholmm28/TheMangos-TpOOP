<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.estaciones.CrearEstacionController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="subtitulo" text="Gestión de estaciones" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Hyperlink onAction="#volver" styleClass="link" text="← Volver" />
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Formulario de nueva estacion -->
                  <ScrollPane fitToWidth="true" maxWidth="440.0" minWidth="380.0" prefWidth="440.0" style="-fx-background-color: transparent; -fx-background: transparent;">
                     <content>
                        <VBox spacing="14.0" styleClass="card">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="titulo" text="Nueva estación" />
                                    <Label styleClass="subtitulo" text="Cargá los datos y cuántos lugares tiene para cada tipo de vehículo" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="campo-label" text="Código" />
                                    <TextField fx:id="txtCodigo" promptText="Ej: E01" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="campo-label" text="Dirección" />
                                    <TextField fx:id="txtDireccion" promptText="Ej: Av. Corrientes 1234" />
                                 </children>
                              </VBox>
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="campo-label" text="Latitud" />
                                          <TextField fx:id="txtLatitud" promptText="-34.6037" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="campo-label" text="Longitud" />
                                          <TextField fx:id="txtLongitud" promptText="-58.3816" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label styleClass="seccion-titulo" text="Capacidad por tipo" />
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="campo-label" text="Bicicletas" />
                                          <TextField fx:id="txtCapBicicleta" promptText="Ej: 10" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="campo-label" text="Bici eléctricas" />
                                          <TextField fx:id="txtCapBiciElectrica" promptText="Ej: 5" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="campo-label" text="Monopatines" />
                                          <TextField fx:id="txtCapMonopatin" promptText="Ej: 5" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#crearEstacion" styleClass="boton-primario" text="Crear estación" />
                              <Label fx:id="lblMensajeEstacion" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                           </children>
                           <padding>
                              <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <!-- Estaciones creadas y sus vehiculos -->
                  <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="seccion-titulo" text="Estaciones" />
                        <ListView fx:id="lstEstaciones" VBox.vgrow="ALWAYS">
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no hay estaciones" />
                           </placeholder>
                        </ListView>
                        <Label fx:id="lblVehiculosDe" styleClass="seccion-titulo" text="Vehículos de la estación" />
                        <ListView fx:id="lstVehiculos" minHeight="150.0" prefHeight="180.0">
                           <placeholder>
                              <Label styleClass="subtitulo" text="Seleccioná una estación para ver sus vehículos" />
                           </placeholder>
                        </ListView>
                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-label" text="Tipo de vehículo" />
                                    <ComboBox fx:id="cmbTipoVehiculo" maxWidth="1.7976931348623157E308" promptText="Elegí un tipo" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-label" text="Código del vehículo" />
                                    <TextField fx:id="txtCodigoVehiculo" promptText="Ej: B001" />
                                 </children>
                              </VBox>
                              <Button mnemonicParsing="false" onAction="#agregarVehiculo" styleClass="boton-primario" text="Agregar a la estación" />
                           </children>
                        </HBox>
                        <Label fx:id="lblMensajeVehiculo" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
