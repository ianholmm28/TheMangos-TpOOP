<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.usuarios.RecargarSaldoController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Hyperlink onAction="#volver" styleClass="link" text="← Volver al inicio" />
            <HBox alignment="TOP_CENTER" fillHeight="false" spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox maxWidth="520.0" prefWidth="520.0" spacing="18.0" styleClass="card">
                     <children>
                        <Label styleClass="saldo-label" text="Saldo actual" />
                        <Label fx:id="lblSaldo" styleClass="saldo-monto" text="\$ 0,00" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="titulo" text="Recargar saldo" />
                              <Label styleClass="subtitulo" text="Elegí con qué pagar y cuánto querés cargar" wrapText="true" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="campo-label" text="Medio de pago" />
                              <ComboBox fx:id="cmbMedioPago" maxWidth="1.7976931348623157E308" promptText="Elegí un medio de pago" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="campo-label" text="Monto a cargar" />
                              <TextField fx:id="txtMonto" promptText="Ej: 5000" />
                           </children>
                        </VBox>
                        <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#recargarSaldo" styleClass="boton-primario" text="Recargar" />
                        <Label fx:id="lblMensaje" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
