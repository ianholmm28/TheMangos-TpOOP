<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.general.PantallaPrincipalController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#irAAjustes" styleClass="boton-secundario" text="Ajustes" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="24.0">
         <children>
            <HBox spacing="24.0">
               <children>
                  <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="saldo-label" text="Saldo disponible" />
                        <Label fx:id="lblSaldo" styleClass="saldo-monto" text="\$ 0,00" />
                        <HBox spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#recargarSaldo" styleClass="boton-primario" text="Recargar saldo" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
                     </padding>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" minWidth="320.0" spacing="12.0" styleClass="card">
                     <children>
                        <Label fx:id="lblEstadoViaje" styleClass="subtitulo" wrapText="true" />
                        <Button fx:id="btnDetalleViaje" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#verDetalleViaje" styleClass="boton-secundario" text="Detalles de viaje en curso" />
                        <Button fx:id="btnIniciarViaje" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarVehiculo" styleClass="boton-primario" text="Iniciar nuevo viaje" />
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="seccion-titulo" text="Últimos viajes" />
                        <ListView fx:id="lstViajes" VBox.vgrow="ALWAYS">
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no hiciste ningún viaje" />
                           </placeholder>
                        </ListView>
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
                  <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="seccion-titulo" text="Movimientos" />
                        <ListView fx:id="lstMovimientos" VBox.vgrow="ALWAYS">
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no hay movimientos" />
                           </placeholder>
                        </ListView>
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
