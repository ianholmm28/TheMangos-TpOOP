<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.general.DetalleViajeController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Hyperlink onAction="#volver" styleClass="link" text="← Volver al inicio" />
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Datos del viaje y devolucion -->
                  <VBox maxWidth="440.0" minWidth="380.0" prefWidth="440.0" spacing="16.0" styleClass="card">
                     <children>
                        <Label styleClass="saldo-label" text="Viaje en curso" />
                        <Label fx:id="lblVehiculo" styleClass="titulo" text="Vehículo" />
                        <Label fx:id="lblDetalle" styleClass="subtitulo" wrapText="true" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="campo-label" text="Estación de destino" />
                              <ComboBox fx:id="cmbDestino" maxWidth="1.7976931348623157E308" promptText="Elegí una estación" />
                              <Label fx:id="lblLugares" styleClass="subtitulo" wrapText="true" />
                           </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button fx:id="btnDevolver" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#finalizarViaje" styleClass="boton-primario" text="Devolver vehículo" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" fx:id="btnCancelar" onAction="#cancelarViaje" styleClass="boton-secundario" text="Cancelar viaje (hasta 2 min)" />
                        <Label fx:id="lblMensaje" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                     </padding>
                  </VBox>

                  <!-- Puntos del recorrido -->
                  <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="seccion-titulo" text="Puntos del recorrido" />
                              <Label fx:id="lblDistancia" styleClass="subtitulo" text="Distancia recorrida: 0,00 km" />
                           </children>
                        </VBox>
                        <TableView fx:id="tablaPuntos" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colNumero" prefWidth="50.0" text="#" />
                              <TableColumn fx:id="colHora" prefWidth="140.0" text="Hora" />
                              <TableColumn fx:id="colLatitud" prefWidth="130.0" text="Latitud" />
                              <TableColumn fx:id="colLongitud" prefWidth="130.0" text="Longitud" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <placeholder>
                              <Label styleClass="subtitulo" text="Todavía no agregaste puntos" />
                           </placeholder>
                        </TableView>
                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-label" text="Latitud" />
                                    <TextField fx:id="txtLatitud" promptText="-34.6037" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="campo-label" text="Longitud" />
                                    <TextField fx:id="txtLongitud" promptText="-58.3816" />
                                 </children>
                              </VBox>
                              <Button mnemonicParsing="false" fx:id="btnAgregarPunto" onAction="#agregarPunto" styleClass="boton-primario" text="Agregar punto" />
                           </children>
                        </HBox>
                        <Label fx:id="lblMensajePunto" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
