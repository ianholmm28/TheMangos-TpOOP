<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.general.PantallaViajeController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="app-nombre" text="TheMangos" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblBienvenida" styleClass="subtitulo" text="Hola, usuario" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-secundario" text="Cerrar sesión" />
         </children>
         <padding>
            <Insets bottom="14.0" left="28.0" right="28.0" top="14.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <Hyperlink onAction="#volver" styleClass="link" text="← Volver al inicio" />

            <HBox spacing="24.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="titulo" text="1. Estación de salida" />
                              <Label styleClass="subtitulo" text="Elegí de dónde salís y qué vehículo querés usar" wrapText="true" />
                           </children>
                        </VBox>
                        <ComboBox fx:id="cmbSalida" maxWidth="1.7976931348623157E308" promptText="Elegí una estación" />
                        <Label styleClass="campo-label" text="Vehículos en la estación" />
                        <ListView fx:id="lstVehiculos" VBox.vgrow="ALWAYS">
                           <placeholder>
                              <Label fx:id="lblSinVehiculos" styleClass="subtitulo" text="Elegí una estación para ver sus vehículos" />
                           </placeholder>
                        </ListView>
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                     </padding>
                  </VBox>
                  <VBox maxWidth="420.0" prefWidth="420.0" spacing="14.0" styleClass="card">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="titulo" text="2. Estación de destino" />
                              <Label styleClass="subtitulo" text="Elegí a qué estación vas a devolver el vehículo" wrapText="true" />
                           </children>
                        </VBox>
                        <ComboBox fx:id="cmbDestino" maxWidth="1.7976931348623157E308" promptText="Elegí una estación" />
                        <Label fx:id="lblLugaresDestino" styleClass="subtitulo" wrapText="true" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Label fx:id="lblResumen" styleClass="subtitulo" wrapText="true" />
                        <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarViaje" styleClass="boton-primario" text="Iniciar viaje" />
                        <Label fx:id="lblMensaje" managed="false" maxWidth="1.7976931348623157E308" styleClass="mensaje" visible="false" wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
